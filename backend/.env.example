# Supabase Shared Pooler (Supavisor) database URL
# NEVER commit a real password here; set DATABASE_URL in the deployment env.
# Format: postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT settings - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-this-secret-key-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origins (comma-separated OR JSON array - both accepted)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
